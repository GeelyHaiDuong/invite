rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsProject(projectId) {
      return signedIn()
        && get(/databases/$(database)/documents/inviteProjects/$(projectId)).data.ownerUid == request.auth.uid;
    }

    match /inviteProjects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow read: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /guests/{guestId} {
        allow read, create, update, delete: if ownsProject(projectId);
      }
    }
  }
}
